{
  "name": "@crowd-mind/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API Gateway for Crowd Mind — routes, rate limiting, and auth proxying",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
