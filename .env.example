# ===========================================
# Crowd Mind - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# General
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crowdmind
POSTGRES_USER=crowdmind
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=crowdmind
MONGO_USER=crowdmind
MONGO_PASSWORD=changeme

# Auth Service
AUTH_SERVICE_PORT=3001
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
BCRYPT_COST_FACTOR=12

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# User Service
USER_SERVICE_PORT=3002
S3_BUCKET_AVATARS=crowdmind-avatars
AWS_REGION=eu-west-1

# Game Engine Service
GAME_ENGINE_PORT=3003
GAME_ENGINE_WS_PORT=8080
MATCHMAKING_INITIAL_RANGE=100
MATCHMAKING_EXPAND_INTERVAL=5000
MATCHMAKING_EXPAND_AMOUNT=50
MATCHMAKING_MAX_WAIT=30000

# Voting Service
VOTING_SERVICE_PORT=3004
VOTING_WS_PORT=8081

# Leaderboard Service
LEADERBOARD_SERVICE_PORT=3005

# Payment Service
PAYMENT_SERVICE_PORT=3006
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
APPLE_SHARED_SECRET=

# Analytics Service
ANALYTICS_SERVICE_PORT=3007
MIXPANEL_TOKEN=
BIGQUERY_PROJECT_ID=

# Notification Service
NOTIFICATION_SERVICE_PORT=3008
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# API Gateway
API_GATEWAY_PORT=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
